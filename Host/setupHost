#! /bin/bash

#curl -s -O /usr/local/bin/hostCrontab https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/setupHost


# Load scripts
curl -s -O ~/.bashrc                   https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Base/script/bashrc
curl -s -O /usr/local/bin/lt           https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Base/script/lt
curl -s -O /usr/local/bin/hi5          https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Base/script/hi5
curl -s -O /usr/local/bin/update       https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Base/script/update
curl -s -O /usr/local/bin/hg           https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Base/script/hg
curl -s -O /usr/local/bin/run          https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/script/run-dkr
#curl -s -O /usr/local/bin/run         https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/script/run-lxd
curl -s -O /usr/local/bin/governor     https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/script/governor
curl -s -O /usr/local/bin/afterReboot  https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/script/afterReboot
curl -s -O /usr/local/bin/dkr-install  https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/script/dkr-install
curl -s -O /usr/local/bin/dkr-swarm    https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/script/dkr-swarm

# Load config files
curl -s -O /etc/ssmtp/ssmtp.conf                      https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/conf/ssmtp.conf
curl -s -O /etc/ssmtp/revaliases                      https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/conf/revaliases
curl -s -O /etc/apt/apt.conf.d/50unattended-upgrades  https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/conf/50unattended-upgrades
curl -s -O /etc/apt/apt.conf.d/20auto-upgrades        https://raw.githubusercontent.com/Martech-WorkShop/toolBelt/Prod/Host/conf/20auto-upgrades

# Set permissions
chmod +x /usr/local/bin/lt
chmod +x /usr/local/bin/hi5
chmod +x /usr/local/bin/update
chmod +x /usr/local/bin/hg
chmod +x /usr/local/bin/run
chmod +x /usr/local/bin/governor
chmod +x /usr/local/bin/afterReboot
chmod +x /usr/local/bin/dkr-install
chmod +x /usr/local/bin/dkr-swarm

# Run scripts
crontab hostCrontab
update
# Run governor after boot.
# bash /usr/local/bin/governor
governor
